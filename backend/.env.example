# Backend Environment Variables
# Copy this file to .env and fill in the values.

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# CORS and rate limiting
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Convex scanner writeback
CONVEX_SITE_URL=https://your-convex-deployment.convex.site
SCANNER_SERVICE_TOKEN=replace-with-a-long-random-shared-secret

# Optional AI enrichment
# HUGGINGFACE_API_TOKEN=hf_...

# Optional monitoring
# SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Temporary migration/backout only. Remove after Supabase cutover.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
